# Copy to .env and fill in. .env is gitignored.

# --- core (M1) ---
OLLAMA_BASE_URL=http://localhost:11434
COMPANY_CONFIG_PATH=./company_config.json
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- rag (M2) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- notifications (M4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# VAPID keys for Web Push. TODO(M4): generate with `vapid --gen`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- observability (M5) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chain-of-command
