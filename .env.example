# Copy to .env and fill in. .env is gitignored.

# --- core (M1) ---
OLLAMA_BASE_URL=http://localhost:11434
COMPANY_CONFIG_PATH=./company_config.json
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- rag (M2) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- external MCP servers (M3) ---
# Tavily — free tier, 1,000 credits/month, no credit card required. Get one at
# app.tavily.com/home. Referenced via ${TAVILY_API_KEY} in
# company_config.json's web_search server entry — never put the key directly
# in company_config.json. (Tavily's MCP server also supports fully keyless,
# rate-limited access with no account at all — see
# company_config.example.json's "_comment_external" for the header.)
TAVILY_API_KEY=

# --- notifications (M4) ---
# Used to build the "join the live session" link in escalation emails.
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- observability (M5) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chain-of-command
